programa {
  funcao inicio() {
    inteiro salario, idade
    escreva ("Digite seu salário: ")
    leia (salario)
    escreva ("Digite sua idade: ")
    leia (idade)
    se (salario >= 3000 e idade >=21) {
    escreva ("Empréstimo aprovado") 
    } senao {
      escreva ("Empréstimo não aprovado")
  }
}
}