programa {
  funcao inicio() {
    inteiro media, renda
    escreva ("Digite sua média: ")
    leia (media)
    escreva ("Digite sua renda: ")
    leia (renda)
    se (media >= 8 e renda <=3000) {
    escreva ("Você tem direito a bolsa de estudos") 
    } senao {
      escreva ("Você não tem direito a bolsa de estudos")
  }
}
}