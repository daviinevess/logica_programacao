programa {
  funcao inicio() {
    real nota
    escreva ("Digite uma nota: ")
    leia (nota)
    se (nota >= 9.0 e nota <=10.0) {
    escreva ("A")}
    se (nota >= 7.0 e nota <= 8.9) {
    escreva ("B")}
    se (nota >= 5.0 e nota <= 6.9) {
    escreva ("C")}
    se (nota >= 3.0 e nota <= 4.9) {
    escreva ("D") }
    se (nota >= 0.0 e nota <= 2.9) {
    escreva ("E") }
  }
}