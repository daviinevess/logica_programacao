programa {
  funcao inicio() {
    inteiro numero, positivo, negativo
    escreva ("Digite um numero: ")
    leia (numero)
    se (numero > 0) {
    escreva ("O número é positivo")
  } se (numero < 0) {
    escreva ("O número é negativo") }
    se (numero == 0) {
    escreva ("O número é neutro") }
  }

  }
}
