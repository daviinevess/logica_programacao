programa {
  funcao inicio() {
    inteiro num1, num2
    escreva("Digite um número: ")
    leia(num1)
    escreva("Digite outro número: ")
    leia(num2)
    se(num1 > num2){
    escreva("O ", num1," é maior que o ", num2)}
     se(num1 < num2){
    escreva("O ", num2," é maior que o ", num1)}
     se(num1 == num2){
    escreva("O ", num1," é igual ao ", num2)}
  }
}
